<?xml version="1.0" encoding="UTF-8"?>
<definitions
  name="EInvoiceService"
  targetNamespace="https://einvoice.example.com/wsdl"
  xmlns="http://schemas.xmlsoap.org/wsdl/"
  xmlns:tns="https://einvoice.example.com/wsdl"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- ── Types ── -->
  <types>
    <xsd:schema targetNamespace="https://einvoice.example.com/wsdl">

      <xsd:element name="SubmitInvoiceRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="invoiceNumber" type="xsd:string"/>
            <xsd:element name="issueDate"     type="xsd:date"/>
            <xsd:element name="dueDate"       type="xsd:date" minOccurs="0"/>
            <xsd:element name="currency"      type="xsd:string"/>
            <xsd:element name="supplier"      type="tns:PartyType"/>
            <xsd:element name="buyer"         type="tns:PartyType"/>
            <xsd:element name="lineItems"     type="tns:LineItemListType"/>
            <xsd:element name="taxTotal"      type="xsd:decimal"/>
            <xsd:element name="totalAmount"   type="xsd:decimal"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="SubmitInvoiceResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="submissionId" type="xsd:string"/>
            <xsd:element name="status"       type="xsd:string"/>
            <xsd:element name="timestamp"    type="xsd:dateTime"/>
            <xsd:element name="message"      type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetInvoiceStatusRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="invoiceId" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetInvoiceStatusResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="invoiceId"  type="xsd:string"/>
            <xsd:element name="status"     type="xsd:string"/>
            <xsd:element name="updatedAt"  type="xsd:dateTime"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="PartyType">
        <xsd:sequence>
          <xsd:element name="abn"     type="xsd:string"/>
          <xsd:element name="name"    type="xsd:string"/>
          <xsd:element name="address" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="LineItemListType">
        <xsd:sequence>
          <xsd:element name="item" type="tns:LineItemType" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="LineItemType">
        <xsd:sequence>
          <xsd:element name="description" type="xsd:string"/>
          <xsd:element name="quantity"    type="xsd:decimal"/>
          <xsd:element name="unitPrice"   type="xsd:decimal"/>
          <xsd:element name="taxRate"     type="xsd:decimal"/>
          <xsd:element name="totalAmount" type="xsd:decimal"/>
        </xsd:sequence>
      </xsd:complexType>

    </xsd:schema>
  </types>

  <!-- ── Messages ── -->
  <message name="SubmitInvoiceInput">
    <part name="parameters" element="tns:SubmitInvoiceRequest"/>
  </message>
  <message name="SubmitInvoiceOutput">
    <part name="parameters" element="tns:SubmitInvoiceResponse"/>
  </message>

  <message name="GetInvoiceStatusInput">
    <part name="parameters" element="tns:GetInvoiceStatusRequest"/>
  </message>
  <message name="GetInvoiceStatusOutput">
    <part name="parameters" element="tns:GetInvoiceStatusResponse"/>
  </message>

  <!-- ── Port Type ── -->
  <portType name="EInvoicePortType">

    <operation name="SubmitInvoice">
      <documentation>
        Submit a UBL 2.1 compliant electronic invoice to the PEPPOL gateway
        for validation and archiving.
      </documentation>
      <input  message="tns:SubmitInvoiceInput"/>
      <output message="tns:SubmitInvoiceOutput"/>
    </operation>

    <operation name="GetInvoiceStatus">
      <documentation>
        Retrieve the current processing status of a previously submitted invoice.
      </documentation>
      <input  message="tns:GetInvoiceStatusInput"/>
      <output message="tns:GetInvoiceStatusOutput"/>
    </operation>

  </portType>

  <!-- ── Binding ── -->
  <binding name="EInvoiceBinding" type="tns:EInvoicePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

    <operation name="SubmitInvoice">
      <soap:operation soapAction="https://einvoice.example.com/SubmitInvoice"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>

    <operation name="GetInvoiceStatus">
      <soap:operation soapAction="https://einvoice.example.com/GetInvoiceStatus"/>
      <input>
        <soap:body use="literal"/>
      </input>
      <output>
        <soap:body use="literal"/>
      </output>
    </operation>

  </binding>

  <!-- ── Service ── -->
  <service name="EInvoiceService">
    <documentation>
      SOAP-based e-invoicing service supporting UBL 2.1 invoice submission
      and status tracking via the PEPPOL BIS 3.0 network.
    </documentation>
    <port name="EInvoicePort" binding="tns:EInvoiceBinding">
      <soap:address location="https://svc.einvoice.example.com/soap/v1"/>
    </port>
  </service>

</definitions>
