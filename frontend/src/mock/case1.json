{
  "openapi": "3.0.3",
  "info": {
    "title": "E-Invoice Submission API",
    "version": "1.0.0",
    "description": "Accepts UBL 2.1-formatted electronic invoices and submits them to the national e-invoicing gateway for compliance verification and archiving."
  },
  "servers": [
    {
      "url": "https://api.einvoice.example.com/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "invoice-submit",
      "description": "Invoice creation and submission endpoints"
    }
  ],
  "paths": {
    "/invoices": {
      "post": {
        "summary": "Submit a new e-invoice",
        "operationId": "submitInvoice",
        "tags": ["invoice-submit"],
        "security": [{ "OAuth2": ["invoices:write"] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invoice submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid invoice payload"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/invoices/{invoiceId}/status": {
      "get": {
        "summary": "Get invoice processing status",
        "operationId": "getInvoiceStatus",
        "tags": ["invoice-submit"],
        "security": [{ "OAuth2": ["invoices:read"] }],
        "parameters": [
          {
            "name": "invoiceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.einvoice.example.com/oauth/token",
            "scopes": {
              "invoices:read":  "Read invoice data",
              "invoices:write": "Submit and manage invoices"
            }
          }
        }
      }
    },
    "schemas": {
      "InvoiceRequest": {
        "type": "object",
        "required": ["invoiceNumber", "issueDate", "supplier", "buyer", "lineItems"],
        "properties": {
          "invoiceNumber": { "type": "string", "example": "INV-2026-00123" },
          "issueDate":     { "type": "string", "format": "date", "example": "2026-06-29" },
          "dueDate":       { "type": "string", "format": "date", "example": "2026-07-29" },
          "currency":      { "type": "string", "example": "AUD" },
          "supplier": {
            "type": "object",
            "properties": {
              "abn":     { "type": "string", "example": "51824753556" },
              "name":    { "type": "string", "example": "Acme Pty Ltd" },
              "address": { "type": "string", "example": "100 George St, Sydney NSW 2000" }
            }
          },
          "buyer": {
            "type": "object",
            "properties": {
              "abn":     { "type": "string", "example": "87654321012" },
              "name":    { "type": "string", "example": "BuyerCo Pty Ltd" },
              "address": { "type": "string", "example": "200 Collins St, Melbourne VIC 3000" }
            }
          },
          "lineItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "quantity":    { "type": "number" },
                "unitPrice":   { "type": "number" },
                "taxRate":     { "type": "number", "example": 0.1 },
                "totalAmount": { "type": "number" }
              }
            }
          },
          "taxTotal":    { "type": "number", "example": 100.00 },
          "totalAmount": { "type": "number", "example": 1100.00 }
        }
      },
      "InvoiceResponse": {
        "type": "object",
        "properties": {
          "submissionId": { "type": "string", "example": "sub-abc-001" },
          "status":       { "type": "string", "enum": ["RECEIVED", "PROCESSING", "ACCEPTED", "REJECTED"] },
          "timestamp":    { "type": "string", "format": "date-time" },
          "message":      { "type": "string" }
        }
      },
      "InvoiceStatus": {
        "type": "object",
        "properties": {
          "invoiceId":    { "type": "string" },
          "status":       { "type": "string" },
          "updatedAt":    { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
