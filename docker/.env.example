# Copy this file to docker/.env before starting the project.
# Replace all placeholder secrets. Compose refuses to start when they are missing.
POSTGRES_DB=bread
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
POSTGRES_PORT=5432

# Keep the user, password and database name aligned with the POSTGRES_* values above.
# Percent-encode reserved URL characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql://postgres:replace-with-a-url-safe-database-password@db:5432/bread
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

BACKEND_PORT=8000
APP_PORT=8080

# PostgreSQL executes this file only when the data volume is created.
DB_INIT_SQL=DB/19.7database.sql
